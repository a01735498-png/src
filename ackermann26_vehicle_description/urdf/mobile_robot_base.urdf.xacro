<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="the_first_vehicle">


    <xacro:include filename="common_properties.xacro"/>
    <xacro:include filename="mobile_robot_gazebo.xacro"/>
    <xacro:property name="wheel_radius" value="0.033"/>
    <xacro:property name="wheel_width" value="0.022"/>
    <xacro:property name="chassis_length" value="0.256"/>
    <xacro:property name="csi_radius" value="0.01" />
    <xacro:property name="csi_length" value="0.02" />

    <xacro:macro name="csi" params="prefix">
        <link name="${prefix}">
           <visual>
            <geometry>
                <cylinder radius="${csi_radius}" length="${csi_length}"/>
            </geometry>
            <material name="green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.02 0.02"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertia m="0.015" r="${csi_radius}" l="${csi_length}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:cylinder_inertia m="0.025" r="${wheel_radius}" l="${wheel_width}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        </link>
    </xacro:macro>


    <link name="base_footprint"/>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>


    <link name="base_link">
        <visual>
            <geometry>
                <box size="${chassis_length} 0.148 0.022"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${chassis_length} 0.148 0.022"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="0.5" l="${chassis_length}" w="0.148" h="0.022" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>


    <xacro:wheel_link prefix="rear_left_wheel"/>
    <xacro:wheel_link prefix="rear_right_wheel"/>
    <xacro:wheel_link prefix="front_left_wheel"/>
    <xacro:wheel_link prefix="front_right_wheel"/>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel"/>
        <origin xyz="-0.128 -0.085 0" rpy="1.57 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>


    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel"/>
        <origin xyz="-0.128 0.085 0" rpy="1.57 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>


    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="front_left_steering"/>
        <child link="front_left_wheel"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="rear_left_wheel_joint" multiplier="1" offset="0"/>
    </joint>


    <link name="front_left_steering">
        <xacro:cylinder_inertia m="0.00001" r="0.003" l="0.02" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>
    <joint name="front_left_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_left_steering"/>
        <origin xyz="0.128 -0.085 0" rpy="1.57 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.5236" upper="0.5236" effort="0.0405" velocity="3.125"/>
    </joint>


    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="front_right_steering"/>
        <child link="front_right_wheel"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="rear_right_wheel_joint" multiplier="1" offset="0"/>
    </joint>


    <link name="front_right_steering">
        <xacro:cylinder_inertia m="0.00001" r="0.003" l="0.02" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>
    
    <joint name="front_right_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_right_steering"/>
        <origin xyz="0.128 0.085 0" rpy="1.57 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.5236" upper="0.5236" effort="0.0405" velocity="3.125"/>
    </joint>

    <xacro:csi prefix="front_csi"/>
    <xacro:csi prefix="rear_csi"/>
    <xacro:csi prefix="left_csi"/>
    <xacro:csi prefix="right_csi"/>

    <joint name="csi_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_csi"/>
        <origin xyz="0.193 0.0 0.0953" rpy="-1.57 0 -1.57"/>
    </joint>

    <joint name="csi_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_csi"/>
        <origin xyz="-0.165 0.0 0.0953" rpy="-1.57 0 1.57"/>
    </joint>

    <joint name="csi_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="left_csi"/>
        <origin xyz="0.014 0.0438 0.0953" rpy="-1.57 0 0"/>
    </joint>

    <joint name="csi_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="right_csi"/>
        <origin xyz="0.014 -0.0674 0.0953" rpy="-1.57 0 3.1416"/>
    </joint>


    <link name="IMU">
        <visual>
            <geometry>
                <box size="0.03 0.035 0.0001"/>
            </geometry>
            <material name="yellow">
                <color rgba="1.0 1.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.03 0.035 0.0001"/>
            </geometry>
        </collision>

        <xacro:box_inertia m="0.004" l="0.03" w="0.0001" h="0.035" o_xyz="0 0 0" o_rpy="1.57 0 0"/>
    </link>

    <joint name="IMU_joint" type="fixed">
        <parent link="base_link"/>
        <child link="IMU"/>
        <origin xyz="0.1278 0.0223 0.0895" rpy="0 0 0"/>
    </joint>


    <link name="realsense">
        <visual>
            <geometry>
                <box size="0.0883 0.0229 0.0255"/>
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.0883 0.0229 0.0255"/>
            </geometry>
        </collision>

        <xacro:box_inertia m="0.07" l="0.0883" w="0.0229" h="0.0255" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="realsense_joint" type="fixed">
        <parent link="base_link"/>
        <child link="realsense"/>
        <origin xyz="0.0822 -0.0001 0.1582" rpy="-1.57 0 -1.57"/>
    </joint>


    <link name="LiDAR">
        <visual>
            <geometry>
                <cylinder radius="0.032" length="0.03"/>
            </geometry>
            <material name="cyan">
                <color rgba="0.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.0324 0.0324 0.0208"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.3" r="0.032" l="0.03" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="LiDAR"/>
        <origin xyz="-0.0108 -0.0001 0.186" rpy="0 0 1.57"/>
    </joint>

</robot>