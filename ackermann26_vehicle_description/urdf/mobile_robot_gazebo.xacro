<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="the_first_vehicle">
    <xacro:property name="wheel_separation" value="0.17"/>
    <gazebo>
        <plugin name="gz::sim::systems::AckermannSteering" filename="gz-sim-ackermann-steering-system">
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <left_steering_joint>front_left_steering_joint</left_steering_joint>
            <right_steering_joint>front_right_steering_joint</right_steering_joint>
            <wheel_separation>${wheel_separation}</wheel_separation>
            <kingpin_width>${wheel_separation+0.8}</kingpin_width>
            <wheel_base>0.256</wheel_base>
            <steering_limit>0.5</steering_limit>
            <wheel_radius>0.033</wheel_radius>  
            <topic>cmd_vel</topic>  
            <frame_id>odo</frame_id> 
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

        <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
            <topic>joint_states</topic>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>front_left_steering_joint</joint_name>
            <joint_name>front_right_steering_joint</joint_name>

        </plugin>

        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>

    </gazebo>

        <gazebo reference="front_csi">
            <sensor name="csi_front_camera" type="camera">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>30</update_rate>
                <topic>front_camera/image_raw</topic>
                <gz_frame_id>front_csi</gz_frame_id>
                <pose>0 0 0 1.5707963 -1.5707963 0</pose>
                <camera>
                    <horizontal_fov>2.79253</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10</far>
                    </clip>  
                </camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>
            </sensor>
        </gazebo>

        <gazebo reference="rear_csi">
            <sensor name="csi_rear_camera" type="camera">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>30</update_rate>
                <topic>rear_camera/image_raw</topic>
                <gz_frame_id>rear_csi</gz_frame_id>
                <camera>
                    <horizontal_fov>1.3962634</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                </camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>
            </sensor>
        </gazebo>


        <gazebo reference="left_csi">
            <sensor name="csi_left_camera" type="camera">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>30</update_rate>
                <topic>left_camera/image_raw</topic>
                <gz_frame_id>left_csi</gz_frame_id>
                <camera>
                    <horizontal_fov>2.79253</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10</far>
                    </clip>
                </camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>
            </sensor>
        </gazebo>


        <gazebo reference="right_csi">
            <sensor name="csi_right_camera" type="camera">
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>30</update_rate>
                <topic>right_camera/image_raw</topic>
                <gz_frame_id>right_csi</gz_frame_id>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10</far>
                    </clip>
                </camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>
            </sensor>
        </gazebo>


        <gazebo reference="IMU">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <topic>imu</topic>
                <gz_frame_id>imu</gz_frame_id>
                <imu>
                </imu>
            </sensor>
        </gazebo>


        <gazebo reference="LiDAR">
            <sensor name="LiDAR_sensor" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>15</update_rate>
                <topic>scan</topic>
                <gz_frame_id>LiDAR</gz_frame_id>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>720</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.1416</min_angle>
                            <max_angle>3.1416</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>20.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>  
            </sensor>  
        </gazebo>

        <gazebo reference="realsense">
            <sensor name="realsense_sensor" type="rgbd_camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <topic>realsense/depth/image_raw</topic>
                <pose>0 0 0 1.5708 -1.5708 0</pose>
                <gz_frame_id>realsense</gz_frame_id>
                <camera>
                    <horizontal_fov>1.3962634</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                        <format>R8G8B8</format>
                    </image>

                    <clip>
                        <near>0.1</near>
                        <far>300</far>
                    </clip>
                </camera>  
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>15</far>
                    </clip>
                </depth_camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>  
            </sensor>
        </gazebo>
</robot>